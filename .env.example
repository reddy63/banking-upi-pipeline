# ── Environment Configuration — Banking UPI Pipeline ──────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Mock API Server ───────────────────────────────────────────────────────────
MOCK_API_BASE_URL=http://localhost:8000
MOCK_API_KEY=dev-api-key-123
API_PAGE_SIZE=200
API_RATE_LIMIT_DELAY=0.3

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Snowflake (Production) ────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=pipeline_user
SNOWFLAKE_PASSWORD=your_secure_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BANKING_DW
SNOWFLAKE_SCHEMA=RAW_LAYER
SNOWFLAKE_ROLE=DATA_ENGINEER

# ── PostgreSQL (Airflow Metadata) ─────────────────────────────────────────────
POSTGRES_CONN=postgresql://airflow:airflow@localhost:5432/airflow

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__CORE__FERNET_KEY=  # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__EXECUTOR=LocalExecutor
PIPELINE_ROOT=/path/to/banking-upi-pipeline

# ── dbt ──────────────────────────────────────────────────────────────────────
DBT_TARGET=dev
DBT_DUCKDB_PATH=./delta_lake/banking_dw.duckdb

# ── Alerting ──────────────────────────────────────────────────────────────────
ALERT_EMAIL=de-alerts@banking.internal
